{
  "name": "flashsale-backend",
  "version": "0.1.0",
  "private": true,
  "description": "FlashSale API — ticket flash-sale backend (Express + PostgreSQL + Redis + BullMQ)",
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
