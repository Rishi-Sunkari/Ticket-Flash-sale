# ---------------------------------------------------------------------------
# FlashSale backend environment variables
# Copy this file to `.env` and adjust the values for your machine.
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL (Prisma reads this exact URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flashsale?schema=public

# Redis (BullMQ + future atomic inventory)
REDIS_URL=redis://127.0.0.1:6379

# Auth — JWT_SECRET must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1h

# Browser origin(s) allowed to call the API (comma-separated list supported)
CORS_ORIGIN=http://localhost:4200

# Observability
LOG_LEVEL=info

# Queue / workers
QUEUE_CONCURRENCY=5
RESERVATION_TTL_SECONDS=600
EXPIRATION_SWEEP_INTERVAL_MS=60000
